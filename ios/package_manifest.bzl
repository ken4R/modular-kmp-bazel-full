"""Text of the `Package.swift` of an iOS module.

Plain string building, without any Bazel API: `ios_module` is the only caller.
"""

SWIFT_TOOLS_VERSION = "5.9"

def _relative_path(from_package, to_package):
    """Returns the path that leads from one Bazel package to another, for example "../../Core/DesignSystem"."""
    source = from_package.split("/")
    target = to_package.split("/")
    common = 0
    for index in range(min(len(source), len(target))):
        if source[index] != target[index]:
            break
        common = index + 1
    return "/".join([".."] * (len(source) - common) + target[common:])

def _swift_target(kind, name, dependencies):
    """Returns the lines that declare one target of the package."""
    if not dependencies:
        return ['        .%s(name: "%s"),' % (kind, name)]
    lines = [
        "        .%s(" % kind,
        '            name: "%s",' % name,
        "            dependencies: [",
    ]
    for dependency in dependencies:
        lines.append("                %s," % dependency)
    lines.append("            ]")
    lines.append("        ),")
    return lines

def package_manifest(module, bazel_package, minimum_ios_version, dependencies, xcframeworks, has_tests):
    """Returns the content of the `Package.swift` of a module.

    Args:
        module: name of the module. It is also the name of the package, of its product and of its target.
        bazel_package: Bazel package of the module, for example "ios/Features/Login".
        minimum_ios_version: oldest iOS version the module supports, for example "17.0".
        dependencies: Bazel packages of the modules this one depends on.
        xcframeworks: dict that maps a framework name to the path of its `.xcframework` in the module.
        has_tests: whether the module has tests in `Tests/<module>Tests`.

    Returns:
        The file content, as a string.
    """
    lines = [
        "// swift-tools-version: " + SWIFT_TOOLS_VERSION,
        "",
        "// Generated from BUILD.bazel. Do not edit this file: change BUILD.bazel, then run",
        "//     bazel run //%s:package_swift" % bazel_package,
        "",
        "import PackageDescription",
        "",
        "let package = Package(",
        '    name: "%s",' % module,
        '    platforms: [.iOS("%s")],' % minimum_ios_version,
        "    products: [",
        '        .library(name: "%s", targets: ["%s"]),' % (module, module),
        "    ],",
    ]

    if dependencies:
        lines.append("    dependencies: [")
        for dependency in dependencies:
            lines.append('        .package(path: "%s"),' % _relative_path(bazel_package, dependency))
        lines.append("    ],")

    target_dependencies = []
    for dependency in dependencies:
        name = dependency.split("/")[-1]
        target_dependencies.append('.product(name: "%s", package: "%s")' % (name, name))
    for framework in xcframeworks:
        target_dependencies.append('"%s"' % framework)

    lines.append("    targets: [")
    lines.extend(_swift_target("target", module, target_dependencies))
    if has_tests:
        lines.extend(_swift_target("testTarget", module + "Tests", ['"%s"' % module]))
    for framework, path in xcframeworks.items():
        lines.append('        .binaryTarget(name: "%s", path: "%s"),' % (framework, path))
    lines.append("    ]")
    lines.append(")")
    lines.append("")
    return "\n".join(lines)
