load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("//ios:ios_module.bzl", "IOS_MINIMUM_OS_VERSION", "IOS_ONLY", "XCODE_PROJECT_VISIBILITY")

# The application assembles the features and owns navigation. It is the only target that may
# depend on a feature.
swift_library(
    name = "AppLibrary",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "ModularApp",
    target_compatible_with = IOS_ONLY,
    deps = [
        "//ios/Core/DesignSystem",
        "//ios/Features/Login",
        "//ios/SharedKit",
    ],
)

ios_application(
    name = "App",
    bundle_id = "com.example.modular",
    bundle_name = "Modular",
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = ["Info.plist"],
    minimum_os_version = IOS_MINIMUM_OS_VERSION,
    visibility = XCODE_PROJECT_VISIBILITY,
    deps = [":AppLibrary"],
)
