"""Bazel builds everything: the shared Kotlin code, the Android application and the iOS application.

Versions live here and nowhere else. See AGENTS.md for the commands and the module rules.
"""

module(name = "modular_kmp_bazel_full")

# apple_support comes first: its C++ toolchain must be registered before the one of rules_cc.
bazel_dep(name = "apple_support", version = "2.12.0")
bazel_dep(name = "rules_apple", version = "5.4.0")
bazel_dep(name = "rules_swift", version = "4.3.0")

# Constraint values, such as @platforms//os:ios.
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# Writes the generated Package.swift files back to the source tree and tests that they are current.
bazel_dep(name = "bazel_lib", version = "3.8.0")

# Generates the Xcode project: bazel run //ios:xcodeproj
bazel_dep(name = "rules_xcodeproj", version = "4.1.0")

# Kotlin on the JVM, for the shared code on Android and for the Android modules.
bazel_dep(name = "rules_kotlin", version = "2.4.21")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_android", version = "0.8.1")
bazel_dep(name = "rules_jvm_external", version = "7.2")

register_toolchains("//bazel/kotlin:kotlin_toolchain")

# --- Kotlin/Native, for the shared code on iOS: homemade rules, see bazel/kotlin_native ---

kotlin_native = use_extension("//bazel/kotlin_native:extensions.bzl", "kotlin_native")

# The compiler for Macs with Apple silicon. Keep it on the Kotlin version of rules_kotlin above.
kotlin_native.toolchain(
    # What the compiler would otherwise download into ~/.konan/dependencies on its first run: LLVM
    # and libffi, as listed for macos_arm64 in the konan/konan.properties of the distribution.
    dependencies = {
        "https://download.jetbrains.com/kotlin/native/resources/llvm/21-aarch64-macos/llvm-21-aarch64-macos-essentials-97.tar.gz": "62fd78f090353aa7b2c6601ad6f95bd7a0b0558b18f86978043cc878321b408a",
        "https://download.jetbrains.com/kotlin/native/libffi-3.3-1-macos-arm64.tar.gz": "8ca0102ad5b626e8b1699f311ab098354a90154ea3e44951f28ebdd256862ba9",
    },
    sha256 = "bf4edb526d91e17d0862102f69250525d788e79011f86c2c64362749adf260ae",
    version = "2.4.21",
)

# The iOS side of the Kotlin Multiplatform libraries: their klibs, for the Kotlin/Native targets of
# bazel/kotlin_native/targets.bzl, found through the Gradle module metadata that the libraries
# publish. The JVM side of the same libraries is in maven.install below, with the same versions.
kotlin_native.libraries(
    artifacts = [
        "androidx.lifecycle:lifecycle-viewmodel:2.11.0",
        "org.jetbrains.kotlinx:kotlinx-coroutines-core:1.11.0",
        "org.jetbrains.kotlinx:kotlinx-coroutines-test:1.11.0",
    ],
    repositories = [
        "https://repo1.maven.org/maven2",
        "https://maven.google.com",
    ],
)
use_repo(kotlin_native, "kotlin_native", "klibs")

# --- Maven artifacts for the JVM and Android ---

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
    artifacts = [
        # Shared code. The same libraries, for iOS, are in kotlin_native.libraries above.
        "androidx.lifecycle:lifecycle-viewmodel:2.11.0",
        "org.jetbrains.kotlinx:kotlinx-coroutines-core:1.11.0",
        "org.jetbrains.kotlinx:kotlinx-coroutines-test:1.11.0",

        # Android UI. The Compose versions are those of the Compose BOM 2026.09.00.
        "androidx.activity:activity-compose:1.13.0",
        "androidx.compose.material3:material3:1.4.0",
        "androidx.compose.ui:ui:1.12.1",
        "androidx.compose.ui:ui-tooling-preview:1.12.1",
        "androidx.lifecycle:lifecycle-runtime-compose:2.11.0",
        "androidx.lifecycle:lifecycle-viewmodel-compose:2.11.0",
        "org.jetbrains.kotlinx:kotlinx-coroutines-android:1.11.0",

        # Compose compiler, a Kotlin compiler plugin: its version is the Kotlin version.
        "org.jetbrains.kotlin:kotlin-compose-compiler-plugin-embeddable:2.4.21",

        # Android tests
        "androidx.compose.ui:ui-test-junit4:1.12.1",
        "androidx.compose.ui:ui-test-manifest:1.12.1",
        "androidx.test.ext:junit:1.3.0",
        "junit:junit:4.13.2",
        "org.robolectric:robolectric:4.18",
    ],
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    use_starlark_android_rules = True,
)

# The Kotlin standard library comes with the compiler of rules_kotlin: one copy, at its version.
maven.override(
    coordinates = "org.jetbrains.kotlin:kotlin-stdlib",
    target = "@rules_kotlin//kotlin/compiler:kotlin-stdlib",
)
maven.override(
    coordinates = "org.jetbrains.kotlin:kotlin-stdlib-jdk7",
    target = "@rules_kotlin//kotlin/compiler:kotlin-stdlib-jdk7",
)
maven.override(
    coordinates = "org.jetbrains.kotlin:kotlin-stdlib-jdk8",
    target = "@rules_kotlin//kotlin/compiler:kotlin-stdlib-jdk8",
)
use_repo(maven, "maven")

# The Android framework that Robolectric runs the screen tests on: the instrumented jar of the
# targetSdk of android/android_module.bzl, Android 16 (API 36), for Robolectric 4.18 above.
# bazel/android/BUILD.bazel points the tests to it.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "robolectric_android_all",
    downloaded_file_path = "android-all-instrumented-16-robolectric-13921718-2-i7.jar",
    sha256 = "1dbb8f78966631f0483b7e625f279c3b33931de573660645fb2c41d130732a9b",
    urls = ["https://repo1.maven.org/maven2/org/robolectric/android-all-instrumented/16-robolectric-13921718-2-i7/android-all-instrumented-16-robolectric-13921718-2-i7.jar"],
)

# --- Android SDK ---

remote_android_extensions = use_extension(
    "@rules_android//bzlmod_extensions:android_extensions.bzl",
    "remote_android_tools_extensions",
)
use_repo(remote_android_extensions, "android_tools")

# The SDK of ANDROID_HOME. Its newest platform is the compileSdk: install platforms;android-37.0.
android_sdk_repository_extension = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
)
use_repo(android_sdk_repository_extension, "androidsdk")

register_toolchains(
    "@androidsdk//:sdk-toolchain",
    "@androidsdk//:all",
)
