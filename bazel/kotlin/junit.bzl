"""`junit_suite`: one JUnit 4 suite per module, so that a module has one JVM test target.

The JVM tests of a module compile once and run in one JVM, as `./gradlew :<module>:test` does.
Classes follow the Kotlin convention: `<source_root>/com/example/FooTest.kt` holds the class
`com.example.FooTest`. Every class whose name ends with `Test` is part of the suite.
"""

load("@bazel_skylib//rules:write_file.bzl", "write_file")

def junit_suite(name, srcs, source_root, package):
    """Writes the Kotlin source of a suite of every `*Test` class of `srcs`.

    Args:
        name: name of the target that writes the source, to add to the `srcs` of the test.
        srcs: Kotlin test sources, as paths relative to the package.
        source_root: directory of the sources, such as "src/commonTest/kotlin".
        package: Kotlin package of the suite class.

    Returns:
        The fully qualified name of the suite class, for the `test_class` of the test.
    """
    classes = []
    for src in srcs:
        if not src.startswith(source_root + "/") or not src.endswith(".kt"):
            fail("%s is not a Kotlin source of %s." % (src, source_root))
        class_path = src[len(source_root) + 1:-len(".kt")]
        if class_path.split("/")[-1].endswith("Test"):
            classes.append(class_path.replace("/", "."))
    if not classes:
        fail("%s/%s has sources but no *Test class." % (native.package_name(), source_root))

    write_file(
        name = name,
        out = name + "/AllTests.kt",
        content = [
            "// Generated by junit_suite() in bazel/kotlin/junit.bzl: the test classes of %s." % source_root,
            "package " + package,
            "",
            "@org.junit.runner.RunWith(org.junit.runners.Suite::class)",
            "@org.junit.runners.Suite.SuiteClasses(",
        ] + ["    %s::class," % test_class for test_class in classes] + [
            ")",
            "class AllTests",
            "",
        ],
        visibility = ["//visibility:private"],
    )
    return package + ".AllTests"
